# Anthropic API key - required for the tutor to generate explanations and feedback
ANTHROPIC_API_KEY=your-api-key-here

# Claude model to use
ANTHROPIC_MODEL=claude-sonnet-5

# Origin allowed to call this API (the frontend dev server by default)
FRONTEND_ORIGIN=http://localhost:5173

# How long (seconds) a session may sit untouched before it's evicted from
# memory. Default: 2 hours.
SESSION_TTL_SECONDS=7200

# Rate limits (requests per minute). CLAUDE_CALLS_PER_MINUTE caps how often
# one session can trigger a Claude API call (lesson, chat, practice
# feedback); SESSION_CREATES_PER_MINUTE_PER_IP caps new-session creation per
# client IP, closing the obvious bypass of the first limit.
CLAUDE_CALLS_PER_MINUTE=20
SESSION_CREATES_PER_MINUTE_PER_IP=10
